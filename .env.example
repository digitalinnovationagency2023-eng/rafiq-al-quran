# Copy to server/.env and edit. Nothing here is committed.

NODE_ENV=development
PORT=8787
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# Required in production: signs the anonymous session cookie.
SESSION_SECRET=

# Enables /api/admin. Operators send it as the `x-admin-token` header.
# Unset = administration disabled (every /api/admin route answers 503).
# Generate a long random value, e.g. `openssl rand -hex 32`; never commit it.
ADMIN_TOKEN=

# Retention
CONVERSATION_RETENTION_DAYS=90
FEEDBACK_RETENTION_DAYS=365

# Retrieval
RETRIEVAL_MAX_VERSES=8
RETRIEVAL_CONFIDENCE_FLOOR=0.42

# Translation publishing: "label-unverified" or "verified-only"
TRANSLATION_LICENSE_MODE=label-unverified

# Recitation playback (off until recording rights are verified)
RECITATION_ENABLED=false

# Rate limiting (in-process; every request is counted per client and route).
# These are encoded defaults for reference; unset values fall back to them.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
RATE_LIMIT_ASK_MAX=20
RATE_LIMIT_FEEDBACK_MAX=10
# POST /api/assistant: allowed requests per client IP per 10 minutes. Default 20.
RATE_LIMIT_ASSISTANT_MAX=20
# Behind the reverse proxy/TLS terminator set true so Express reads the
# forwarded client address. Required for per-IP rate limiting to see users as
# separate clients; only enable it when the origin is reachable only via the
# proxy (otherwise the forwarded header can be spoofed).
TRUST_PROXY=false

# Optional AI assistance (see docs/AI-ASSISTANT.md). It can only return a short
# neutral small-talk reply, search keywords and OCR text from an attached image;
# it never supplies Quran text, translations or religious interpretation. Leave
# AI_PROVIDER=none (the default) to keep POST /api/assistant answering 503.
#
# Free Google Gemini setup (no billing required):
#   1. Create a free API key at https://aistudio.google.com/app/apikey
#   2. Put these four values in the deployment .env and restart the API:
#        AI_PROVIDER=openai-compatible
#        AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#        AI_MODEL=gemini-2.5-flash
#        AI_API_KEY=<your key - never commit it and never put it in this file>
# Any other OpenAI-compatible chat-completions endpoint can be used instead;
# only AI_PROVIDER=openai-compatible is supported today.
AI_PROVIDER=none
AI_BASE_URL=
AI_MODEL=gemini-2.5-flash
AI_API_KEY=
# Per-request timeout for the provider call, in milliseconds.
AI_TIMEOUT_MS=8000
# Optional hard monthly cap on provider calls (0 = unlimited). Counted per
# calendar month (UTC) in the local database; it stores no prompt or image data.
AI_MAX_MONTHLY_CALLS=0

# Voluntary donations. Disabled by default; live collection additionally needs
# the compliance review recorded.
DONATIONS_ENABLED=false
DONATIONS_COMPLIANCE_APPROVED=false
DONATIONS_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DONATIONS_CURRENCY=AED
DONATIONS_MIN_MINOR=500
DONATIONS_MAX_MINOR=5000000
DONATIONS_RECURRING_ENABLED=false
DONATIONS_SUCCESS_URL=
DONATIONS_CANCEL_URL=

# Optional premium tools (conveniences only; never Quranic content).
PREMIUM_ENABLED=false
PREMIUM_STRIPE_SECRET_KEY=
PREMIUM_WEBHOOK_SECRET=
PREMIUM_CURRENCY=AED

# Feedback WhatsApp channel: only set once a verified number exists.
WHATSAPP_ENABLED=true
WHATSAPP_BUSINESS_NUMBER=97195010254
